%% Local functions
function y=sigmoid(x)
x=max(min(x,35),-35); y=1./(1+exp(-x));
end

function y=normalize01(x)
xmin=min(x); xmax=max(x);
if xmax-xmin<1e-12, y=0.5*ones(size(x));
else, y=(x-xmin)/(xmax-xmin);
end
y=min(max(y,0),1);
end

function [gain,perUAVPower,phi]=optimizeRISChannel(H,G,HRU,P)
% Channel-dependent, toolbox-free RIS phase optimization.
%
% H   : direct UAV-user small-scale channel, NUAV x NUSER
% G   : BS-RIS channel, NRIS x 1
% HRU : RIS-UAV-user channel, NUAV x NRIS x NUSER
%
% A 2-bit quantized RIS phase vector is optimized by coordinate updates.
% The objective explicitly depends on the cascaded BS-RIS-UAV/user channel.
% This is a lightweight multi-user RIS model, not a full beamforming solver.

NUAV=size(H,1); NUSER=size(H,2); NRIS=size(HRU,2);
levels=P.risCandidatePhases(:).';

% Cascaded coefficient for each RIS element, aggregated over users/UAVs.
C=zeros(NRIS,1);
for k=1:NRIS
    C(k)=G(k)*sum(sum(squeeze(HRU(:,k,:))));
end
C=C/(sqrt(mean(abs(C).^2))+eps);

% Quantized phase initialization aligns the dominant cascaded coefficients.
phi=quantizePhase(mod(-angle(C),2*pi),levels);

idx=1:min(P.risOptimizeElements,NRIS);
for it=1:P.risCoordinateIterations
    for kk=1:numel(idx)
        k=idx(kk);
        bestPhi=phi(k);
        bestObj=risObjective(phi,H,G,HRU,P);
        oldPhi=phi(k);
        for c=1:numel(levels)
            phi(k)=levels(c);
            obj=risObjective(phi,H,G,HRU,P);
            if obj>bestObj
                bestObj=obj;
                bestPhi=levels(c);
            end
        end
        phi(k)=bestPhi;
        if ~isfinite(bestObj), phi(k)=oldPhi; end
    end
end

% Per-UAV received power after the optimized RIS phases.
v=G(:).*exp(1j*phi(:));
perUAVPower=zeros(NUAV,1);
for i=1:NUAV
    HR=squeeze(HRU(i,:,:)); % NRIS x NUSER
    casc=v.'*HR;             % 1 x NUSER, no conjugation on v
    field=P.risDirectWeight*H(i,:)+P.risPathScale*casc;
    perUAVPower(i)=mean(abs(field).^2);
end

basePower=mean(abs(H(:)).^2)+eps;
gain=min(1,max(0,mean(perUAVPower)/(basePower+eps)));
gain=0.65+0.35*gain;
end

function obj=risObjective(phi,H,G,HRU,P)
% Vectorized average received-power objective for the cascaded RIS channel.
NUAV=size(H,1); NUSER=size(H,2);
v=G(:).*exp(1j*phi(:));
acc=0;
for i=1:NUAV
    HR=squeeze(HRU(i,:,:)); % NRIS x NUSER
    casc=v.'*HR;
    field=P.risDirectWeight*H(i,:)+P.risPathScale*casc;
    acc=acc+sum(abs(field).^2);
end
obj=acc/(NUAV*NUSER);
end

function q=quantizePhase(phi,levels)
q=zeros(size(phi));
for k=1:numel(phi)
    d=abs(angle(exp(1j*(phi(k)-levels))));
    [~,idx]=min(d);
    q(k)=levels(idx);
end
end
